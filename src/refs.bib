@article{fca:Viaud2018,
	abstract = "It is well-known inside the Formal Concept Analysis (FCA) community that a concept lattice could have an exponential size with respect to the input data. Hence, the size of concept lattices is a critical issue in large real-life data sets. In this paper, we propose to investigate congruence relations as a tool to get meaningful parts of the whole lattice or its implication basis. This paper presents two main theoretical contributions, namely two context (or lattice) decompositions based on congruence relations and new results about implication computation after decomposition.",
	author = "Viaud, Jean-François and Bertet, Karell and Missaoui, Rokia and Demko, Christophe",
	doi = "10.1016/j.dam.2016.11.021",
	issn = "0166-218X",
	journal = "Discrete Applied Mathematics",
	keywords = "Formal Concept Analysis; Concept lattice; Congruence relation; Subdirect decomposition; Doubling convex construction; Implication system",
	note = "Concept Lattices and Applications: Recent Advances and New Opportunities",
	pages = "135–150",
	title = "Using congruence relations to extract knowledge from concept lattices",
	url = "http://www.sciencedirect.com/science/article/pii/S0166218X16305741",
	volume = "249",
	year = "2018"
